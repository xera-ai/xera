{
  "name": "xera-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "workspaces": [
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test packages/core packages/web",
    "test:integration": "bun test packages/cli/test/integration",
    "typecheck": "bun run --filter '*' typecheck",
    "xera:doctor": "xera-internal doctor",
    "xera:eval-deterministic": "xera-internal eval-deterministic",
    "xera:eval-prepare": "xera-internal eval-prepare",
    "xera:eval-report": "xera-internal eval-report",
    "xera:verify-prompts": "xera-internal verify-prompts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  }
}

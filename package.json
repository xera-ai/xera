{
  "name": "xera-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "workspaces": [
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test packages/core packages/web packages/http",
    "test:integration": "XERA_RUN_INTEGRATION=1 bun test packages/cli/test/integration packages/http/test/integration",
    "typecheck": "bun run --filter '*' typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish",
    "xera:doctor": "xera-internal doctor",
    "xera:eval-deterministic": "xera-internal eval-deterministic",
    "xera:eval-prepare": "xera-internal eval-prepare",
    "xera:eval-report": "xera-internal eval-report",
    "xera:verify-prompts": "xera-internal verify-prompts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  }
}

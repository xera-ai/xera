{
  "name": "xera-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xera-ai/xera.git"
  },
  "homepage": "https://github.com/xera-ai/xera#readme",
  "bugs": {
    "url": "https://github.com/xera-ai/xera/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@xera-ai/web --workspace=@xera-ai/http --workspace=@xera-ai/core --workspace=@xera-ai/cli",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run packages/core packages/web packages/http",
    "test:integration": "XERA_RUN_INTEGRATION=1 vitest run packages/cli/test/integration packages/http/test/integration",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "xera:doctor": "xera-internal doctor",
    "xera:eval-deterministic": "xera-internal eval-deterministic",
    "xera:eval-prepare": "xera-internal eval-prepare",
    "xera:eval-report": "xera-internal eval-report",
    "xera:verify-prompts": "xera-internal verify-prompts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@types/node": "25.9.1",
    "tsup": "8.5.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}

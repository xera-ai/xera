import { defineConfig } from '@xera-ai/core';

export default defineConfig({
  adapters: ['web', 'http'],
  {{#if useJiraTracker}}
  jira: {
    baseUrl: '{{jiraBaseUrl}}',
    projectKeys: [{{#each projectKeys}}'{{this}}',{{/each}}],
    fields: {
      story: '{{storyField}}',
      {{#if acceptanceCriteriaField}}acceptanceCriteria: '{{acceptanceCriteriaField}}',{{/if}}
    },
  },
  {{/if}}
  {{#if useGithubTracker}}
  // Ticket keys: GH-<number>. Skill resolves via mcp__github__get_issue when
  // available, else falls back to `gh issue view`. No PAT needed.
  github: { repo: '{{githubRepo}}' },
  {{/if}}
  web: {
    baseUrl: { staging: '{{stagingUrl}}' },
    defaultEnv: 'staging',
    {{#if authEnabled}}auth: {
      strategy: 'storageState',
      setupScript: './shared/auth-setup.ts',
      roles: {
        {{#each roles}}{{this}}: { envEmail: 'TEST_{{upper this}}_EMAIL', envPassword: 'TEST_{{upper this}}_PWD' },
        {{/each}}
      },
    },{{/if}}
  },
  http: {
    baseUrl: { staging: '{{apiBaseUrl}}' },
    defaultEnv: 'staging',
    {{#if openapiPath}}spec: '{{openapiPath}}',{{/if}}
    auth: {
      strategy: '{{authStrategy}}',
      roles: {
        {{#each httpRoles}}{{this}}: { tokenEnv: '{{upper this}}_BEARER_TOKEN' },
        {{/each}}
      },
    },
  },
  // Coverage gap report (v0.8.0+). Run `/xera-coverage` to see UNCOVERED /
  // STALE areas and AC gaps. See docs/CONFIGURATION.md for `criticalAreas`.
  coverage: {
    staleAfterDays: 30,
    criticalAreas: [],
    autoSnapshotOnCoverage: true,
  },
});

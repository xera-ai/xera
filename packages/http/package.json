{
  "name": "@xera-ai/http",
  "version": "0.20.5",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xera-ai/xera.git",
    "directory": "packages/http"
  },
  "homepage": "https://github.com/xera-ai/xera/tree/main/packages/http#readme",
  "bugs": {
    "url": "https://github.com/xera-ai/xera/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime": {
      "source": "./src/runtime/index.ts",
      "import": "./dist/runtime/index.js",
      "types": "./dist/runtime/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "build:types": "tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run build:types"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "11.7.0",
    "@playwright/test": "1.60.0",
    "@xera-ai/core": "^0.20.5",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}

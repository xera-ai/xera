{
  "name": "@xera-ai/web",
  "version": "0.18.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xera-ai/xera.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/xera-ai/xera/tree/main/packages/web#readme",
  "bugs": {
    "url": "https://github.com/xera-ai/xera/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external @playwright/test --external @xera-ai/core --external @cucumber/gherkin --external @cucumber/messages --external fflate",
    "build:types": "tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun run build:types"
  },
  "dependencies": {
    "@cucumber/gherkin": "39.1.0",
    "@cucumber/messages": "32.3.1",
    "@playwright/test": "1.60.0",
    "@xera-ai/core": "^0.18.0",
    "fflate": "0.8.3"
  }
}

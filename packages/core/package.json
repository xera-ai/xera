{
  "name": "@xera-ai/core",
  "version": "0.4.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapter": {
      "bun": "./src/adapter/types.ts",
      "import": "./dist/adapter/types.js",
      "types": "./dist/adapter/types.d.ts"
    }
  },
  "bin": {
    "xera-internal": "./dist/bin/internal.js"
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts ./bin/internal.ts --outdir ./dist --target bun --external @playwright/test --external @xera-ai/web --external zod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3",
    "@xera-ai/web": "^0.2.0",
    "@playwright/test": "1.60.0",
    "fflate": "0.8.3",
    "yaml": "2.9.0"
  }
}

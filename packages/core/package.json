{
  "name": "@xera-ai/core",
  "version": "0.18.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xera-ai/xera.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/xera-ai/xera/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/xera-ai/xera/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapter": {
      "bun": "./src/adapter/types.ts",
      "import": "./dist/adapter/types.js",
      "types": "./dist/adapter/types.d.ts"
    }
  },
  "bin": {
    "xera-internal": "./dist/bin/internal.js"
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/adapter/types.ts --outdir ./dist --root ./src --target bun --external @playwright/test --external @xera-ai/web --external @xera-ai/http --external zod && bun build ./bin/internal.ts --outfile ./dist/bin/internal.js --target bun --external @playwright/test --external @xera-ai/web --external @xera-ai/http --external zod && cp -r src/graph/templates dist/bin/",
    "build:types": "tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun run build:types"
  },
  "dependencies": {
    "zod": "4.4.3",
    "@xera-ai/web": "^0.18.0",
    "@xera-ai/http": "^0.18.0",
    "@playwright/test": "1.60.0",
    "dotenv": "^16.0.0",
    "fflate": "0.8.3",
    "yaml": "2.9.0"
  }
}

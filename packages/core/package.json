{
  "name": "@xera-ai/core",
  "version": "0.15.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapter": {
      "bun": "./src/adapter/types.ts",
      "import": "./dist/adapter/types.js",
      "types": "./dist/adapter/types.d.ts"
    }
  },
  "bin": {
    "xera-internal": "./dist/bin/internal.js"
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts ./bin/internal.ts --outdir ./dist --target bun --external @playwright/test --external @xera-ai/web --external @xera-ai/http --external zod && cp -r src/graph/templates dist/bin/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "4.4.3",
    "@xera-ai/web": "^0.15.0",
    "@xera-ai/http": "^0.15.0",
    "@playwright/test": "1.60.0",
    "dotenv": "^16.0.0",
    "fflate": "0.8.3",
    "yaml": "2.9.0"
  }
}
